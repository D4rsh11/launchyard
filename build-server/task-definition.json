{
    "family": "builder-task",
    "taskRoleArn": "arn:aws:iam::600627334205:role/launchyardBuilderTaskRole",
    "executionRoleArn": "arn:aws:iam::600627334205:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "containerDefinitions": [
        {
            "name": "builder",
            "image": "600627334205.dkr.ecr.ap-south-1.amazonaws.com/launchyard-builder:latest",
            "essential": true,
            "environment": [
                {
                    "name": "AWS_REGION",
                    "value": "ap-south-1"
                },
                {
                    "name": "VALKEY_URL",
                    "value": "${VALKEY_URL}"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/launchyard/builds",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "builder"
                }
            }
        }
    ]
}